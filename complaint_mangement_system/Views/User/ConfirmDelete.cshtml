@{
}


@model complaint_mangement_system.Models.Complaint

@{
    ViewData["Title"] = "Delete Complaint";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-5 text-center">

                    <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>

                    <h2 class="fw-bold mt-3">
                        Delete Complaint?
                    </h2>

                    <p class="text-muted">
                        Are you sure you want to delete this complaint?
                        This action cannot be undone.
                    </p>

                    <div class="bg-light rounded-3 p-3 my-4 text-start">

                        <p class="mb-2">
                            <strong>Complaint ID:</strong>
                            #@Model.complaintid
                        </p>

                        <p class="mb-2">
                            <strong>Title:</strong>
                            @Model.complaintname
                        </p>

                        <p class="mb-0">
                            <strong>Status:</strong>
                            @Model.status
                        </p>

                    </div>

                    <form asp-controller="User"
                          asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.complaintid" />

                        <button type="submit"
                                class="btn btn-danger px-4 me-2">

                            <i class="bi bi-trash me-2"></i>
                            Yes, Delete

                        </button>

                        <a asp-controller="User"
                           asp-action="Dashboard"
                           class="btn btn-outline-secondary px-4">

                            Cancel

                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>