
@model List<complaint_mangement_system.ViewModels.UserComplaintViewModel>

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/User/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Welcome, @ViewBag.UserName!
            </h2>

            <p class="text-muted mb-0">
                Manage your complaints from here.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="User"
               asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle me-1"></i>
                Create Complaint

            </a>

            <a asp-controller="User"
               asp-action="Profile"
               class="btn btn-outline-primary rounded-circle"
               style="width:45px;height:45px;">

                <i class="bi bi-person-fill fs-5"></i>

            </a>

        </div>

    </div>


    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Total Complaints
                            </p>

                            <h2 class="fw-bold">
                                @ViewBag.TotalComplaints
                            </h2>

                        </div>

                        <i class="bi bi-clipboard-data fs-1 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Pending
                            </p>

                            <h2 class="fw-bold">
                                @ViewBag.PendingComplaints
                            </h2>

                        </div>

                        <i class="bi bi-clock-history fs-1 text-warning"></i>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Resolved
                            </p>

                            <h2 class="fw-bold">
                                @ViewBag.ResolvedComplaints
                            </h2>

                        </div>

                        <i class="bi bi-check-circle fs-1 text-success"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="fw-bold mb-0">
                My Complaints
            </h5>

        </div>

        <div class="card-body">

            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>
                                <th>Complaint</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var complaint in Model)
                            {
                                <tr>

                                    <td>
                                        #@complaint.complaintid
                                    </td>

                                    <td>
                                        @complaint.complaintname
                                    </td>

                                    <td>
                                        @complaint.categoryname
                                    </td>

                                    <td>

                                        @if (complaint.status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (complaint.status == "Resolved")
                                        {
                                            <span class="badge bg-success">
                                                Resolved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @complaint.status
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-controller="User"
                                           asp-action="Update"
                                           asp-route-id="@complaint.complaintid"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-controller="User"
                                           asp-action="ConfirmDelete"
                                           asp-route-id="@complaint.complaintid"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No complaints yet
                    </h5>

                    <p class="text-muted">
                        Create your first complaint to get started.
                    </p>

                    <a asp-controller="User"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle me-1"></i>
                        Create Complaint

                    </a>

                </div>
            }

        </div>

    </div>

</div>
