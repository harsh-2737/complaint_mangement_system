@model List<complaint_mangement_system.ViewModels.ComplaintviewModel>

@{
    ViewData["Title"] = "My Complaints";
    Layout = "~/Views/User/_Layout.cshtml";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                My Complaints
            </h2>

            <p class="text-muted">
                View and manage your complaints.
            </p>
        </div>

        <a asp-controller="User"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-2"></i>
            New Complaint

        </a>

    </div>

    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>ID</th>
                            <th>Complaint</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var complaint in Model)
                            {
                                <tr>

                                    <td>
                                        #@complaint.complaintid
                                    </td>

                                    <td>
                                        @complaint.complaintname
                                    </td>

                                    <td>
                                        @complaint.categoryname
                                    </td>

                                    <td>
                                        @complaint.description
                                    </td>

                                    <td>
                                        @complaint.priority
                                    </td>

                                    <td>
                                        @complaint.status
                                    </td>

                                    <td>

                                        <a asp-controller="User"
                                           asp-action="Update"
                                           asp-route-id="@complaint.complaintid"
                                           class="btn btn-sm btn-primary">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-controller="User"
                                           asp-action="ConfirmDelete"
                                           asp-route-id="@complaint.complaintid"
                                           class="btn btn-sm btn-danger">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-5 text-muted">

                                    <i class="bi bi-inbox fs-1"></i>

                                    <p class="mt-2">
                                        You haven't created any complaints yet.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>