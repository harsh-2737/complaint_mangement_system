@{
}

@model List<complaint_mangement_system.ViewModels.StaffRequestViewModel>

@{
    ViewData["Title"] = "Staff Requests";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">
            Staff Requests
        </h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model.Count == 0)
            {
                <div class="text-center p-4">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <h5 class="mt-3">No Pending Staff Requests</h5>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Staff ID</th>
                                <th>Name</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>
                                        @request.staffid
                                    </td>

                                    <td>
                                        @request.name
                                    </td>

                                    <td>
                                        @request.categoryname
                                    </td>

                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @request.status
                                        </span>
                                    </td>

                                    <td>
                                        <a asp-controller="Admin"
                                           asp-action="ApproveStaff"
                                           asp-route-staffid="@request.staffid"
                                           class="btn btn-success btn-sm">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Approve
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="RejectStaff"
                                           asp-route-staffid="@request.staffid"
                                           class="btn btn-danger btn-sm">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Reject
                                        </a>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>