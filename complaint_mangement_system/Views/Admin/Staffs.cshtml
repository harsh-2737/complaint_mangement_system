@{
}

@model List<complaint_mangement_system.ViewModels.StaffCategoryViewModel>

@{
    ViewData["Title"] = "Manage Staffs";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Manage Staffs</h2>
            <p class="text-muted mb-0">
                View and manage staff members according to their categories.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateStaff"
           class="btn btn-primary">
            <i class="bi bi-person-plus-fill me-2"></i>
            Create Staff
        </a>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                Staff Categories
            </h5>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Category ID</th>
                                <th>Category</th>
                                <th>Total Staff</th>
                                <th>Staff Details</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var category in Model)
                            {
                                <tr>

                                    <td>
                                        #@category.categoryid
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @category.categoryname
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-primary">
                                            @category.staffs.Count
                                        </span>
                                    </td>

                                    <td>
                                        @if (category.staffs.Any())
                                        {
                                            <a asp-controller="Admin"
                                               asp-action="CategoryStaffs"
                                               asp-route-categoryid="@category.categoryid"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-people-fill me-1"></i>
                                                View Staff
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No Staff
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-tags fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No categories found
                    </h5>

                    <p class="text-muted">
                        Create a category first to manage staff.
                    </p>

                </div>
            }

        </div>

    </div>

</div>