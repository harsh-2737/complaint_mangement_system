@{
}


@model List<complaint_mangement_system.ViewModels.ComplaintviewModel>

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Admin/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Welcome, @ViewBag.UserName!
            </h2>

            <p class="text-muted mb-0">
                Manage complaints, users and staff from here.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Admin"
               asp-action="Staffs"
               class="btn btn-primary">

                <i class="bi bi-person-badge-fill  me-1"></i>
                Manage Staff

            </a>

            <a asp-controller="Admin"
               asp-action="Users"
               class="btn btn-primary">

                <i class="bi bi-people-fill me-1"></i>
                Manage User

            </a>

            <a asp-controller="Admin"
               asp-action="Profile"
               class="btn btn-outline-primary rounded-circle"
               style="width:45px;height:45px;">

                <i class="bi bi-person-fill fs-5"></i>

            </a>

        </div>

    </div>


    <!-- Dashboard Cards -->

    <div class="row g-4 mb-4">

        <!-- Total Complaints -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Total Complaints
                            </p>

                            <h2 class="fw-bold">
                                @ViewBag.TotalComplaints
                            </h2>

                        </div>

                        <i class="bi bi-clipboard-data fs-1 text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Pending -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Pending
                            </p>

                            <h2 class="fw-bold">
                                @ViewBag.PendingComplaints
                            </h2>

                        </div>

                        <i class="bi bi-clock-history fs-1 text-warning"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- In Progress -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                In Progress
                            </p>

                            <h2 class="fw-bold">
                                @ViewBag.InProgressComplaints
                            </h2>

                        </div>

                        <i class="bi bi-arrow-repeat fs-1 text-info"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- Resolved -->

        <div class="col-md-3">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Resolved
                            </p>

                            <h2 class="fw-bold">
                                @ViewBag.ResolvedComplaints
                            </h2>

                        </div>

                        <i class="bi bi-check-circle fs-1 text-success"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- All Complaints -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    All Complaints
                </h5>

                <a asp-controller="Admin"
                   asp-action="Complaints"
                   class="btn btn-sm btn-outline-primary">

                    View All

                </a>

            </div>

        </div>


        <div class="card-body">

            @if (Model != null && Model.Count > 0)
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>ID</th>

                                <th>Complaint</th>

                                <th>Category</th>

                                <th>Priority</th>

                                <th>Status</th>

                                <th>Action</th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var complaint in Model)
                            {

                                <tr>

                                    <td>
                                        #@complaint.complaintid
                                    </td>


                                    <td>
                                        @complaint.complaintname
                                    </td>


                                    <td>
                                        @complaint.categoryname
                                    </td>


                                    <td>
                                        @complaint.priority
                                    </td>


                                    <td>

                                        @if (complaint.status == "Pending")
                                        {

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                        }
                                        else if (complaint.status == "Assigned")
                                        {

                                            <span class="badge bg-primary">
                                                Assigned
                                            </span>

                                        }
                                        else if (complaint.status == "In Progress")
                                        {

                                            <span class="badge bg-info text-dark">
                                                In Progress
                                            </span>

                                        }
                                        else if (complaint.status == "Resolved")
                                        {

                                            <span class="badge bg-success">
                                                Resolved
                                            </span>

                                        }
                                        else if (complaint.status == "Closed")
                                        {

                                            <span class="badge bg-dark">
                                                Closed
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="badge bg-secondary">
                                                @complaint.status
                                            </span>

                                        }

                                    </td>


                                    <td>

                                        <a asp-controller="Admin"
                                           asp-action="Details"
                                           asp-route-id="@complaint.complaintid"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        @if (complaint.status == "Pending")
                                        {

                                            <a asp-controller="Admin"
                                               asp-action="Assign"
                                               asp-route-id="@complaint.complaintid"
                                               class="btn btn-sm btn-outline-success">

                                                <i class="bi bi-person-plus"></i>

                                            </a>

                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="text-center py-5">

                    <i class="bi bi-inbox fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No complaints yet
                    </h5>

                    <p class="text-muted">
                        There are no complaints in the system.
                    </p>

                </div>

            }

        </div>

    </div>

</div>
