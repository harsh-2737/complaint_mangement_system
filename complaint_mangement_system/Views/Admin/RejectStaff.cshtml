@{
}

@model complaint_mangement_system.ViewModels.StaffRequestViewModel

@{
    ViewData["Title"] = "Reject Staff";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-body text-center p-5">

            <i class="bi bi-x-circle-fill text-danger fs-1"></i>

            <h2 class="mt-3">
                Reject Staff Request
            </h2>

            <p class="text-muted mt-3">
                Are you sure you want to reject this staff request?
            </p>

            <div class="mt-4">

                <p>
                    <strong>Staff ID:</strong>
                    @Model.staffid
                </p>

                <p>
                    <strong>Name:</strong>
                    @Model.name
                </p>

                <p>
                    <strong>Category:</strong>
                    @Model.categoryname
                </p>

            </div>

            <form asp-controller="Admin"
                  asp-action="ConfirmRejectStaff"
                  method="post">

                <input type="hidden"
                       name="staffid"
                       value="@Model.staffid" />

                <button type="submit"
                        class="btn btn-danger me-2">
                    <i class="bi bi-x-circle me-1"></i>
                    Yes, Reject
                </button>

                <a asp-controller="Admin"
                   asp-action="StaffRequests"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>
