@{
}

@model complaint_mangement_system.ViewModels.StaffRegisterViewModel

@{
    ViewData["Title"] = "Create Staff";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light py-4">

    <div class="w-100" style="max-width: 650px;">

        <div class="card border-0 shadow-lg rounded-4">

            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">

                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                         style="width:70px;height:70px;">

                        <i class="bi bi-person-badge-fill fs-2"></i>

                    </div>

                    <h2 class="fw-bold mt-3 mb-1">
                        Create Staff
                    </h2>

                    <p class="text-muted mb-0">
                        Create a new staff member account
                    </p>

                </div>

                <form asp-controller="Admin"
                      asp-action="CreateStaff"
                      method="post">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">

                        <label asp-for="name"
                               class="form-label fw-semibold">
                            Full Name
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-person text-primary"></i>
                            </span>

                            <input asp-for="name"
                                   class="form-control"
                                   placeholder="Enter full name" />

                        </div>

                        <span asp-validation-for="name"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="email"
                               class="form-label fw-semibold">
                            Email Address
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-envelope text-primary"></i>
                            </span>

                            <input asp-for="email"
                                   class="form-control"
                                   placeholder="Enter email address" />

                        </div>

                        <span asp-validation-for="email"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="password"
                               class="form-label fw-semibold">
                            Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-lock text-primary"></i>
                            </span>

                            <input asp-for="password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Create a password" />

                        </div>

                        <span asp-validation-for="password"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="confirm_password"
                               class="form-label fw-semibold">
                            Confirm Password
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-shield-lock text-primary"></i>
                            </span>

                            <input asp-for="confirm_password"
                                   type="password"
                                   class="form-control"
                                   placeholder="Confirm password" />

                        </div>

                        <span asp-validation-for="confirm_password"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="country_code"
                               class="form-label fw-semibold">
                            Country Code
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-globe2 text-primary"></i>
                            </span>

                            <select asp-for="country_code"
                                    class="form-select">

                                <option value="">
                                    Select country code
                                </option>

                                <option value="+91">
                                    India (+91)
                                </option>

                                <option value="+1">
                                    USA/Canada (+1)
                                </option>

                                <option value="+44">
                                    United Kingdom (+44)
                                </option>

                                <option value="+61">
                                    Australia (+61)
                                </option>

                                <option value="+81">
                                    Japan (+81)
                                </option>

                                <option value="+86">
                                    China (+86)
                                </option>

                                <option value="+971">
                                    UAE (+971)
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="country_code"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="phone_no"
                               class="form-label fw-semibold">
                            Phone Number
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-telephone text-primary"></i>
                            </span>

                            <input asp-for="phone_no"
                                   class="form-control"
                                   placeholder="Enter 10 digit phone number" />

                        </div>

                        <span asp-validation-for="phone_no"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="mb-4">

                        <label asp-for="categoryid"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-grid text-primary"></i>
                            </span>

                            <select asp-for="categoryid"
                                    class="form-select">

                                <option value="">
                                    Select Category
                                </option>

                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.categoryid">
                                        @category.categoryname
                                    </option>
                                }

                            </select>

                        </div>

                        <span asp-validation-for="categoryid"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-2">

                        <button type="submit"
                                class="btn btn-primary btn-lg rounded-3 flex-fill">

                            <i class="bi bi-person-plus-fill me-2"></i>
                            Create Staff

                        </button>

                        <a asp-controller="Admin"
                           asp-action="Staffs"
                           class="btn btn-outline-secondary btn-lg rounded-3 flex-fill">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}