@{
}
@{
    ViewData["Title"] = "Create Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model complaint_mangement_system.Models.Category

<h2>Create Category</h2>

<form asp-action="CreateCategory" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="categoryname" class="form-label"></label>

        <input asp-for="categoryname" class="form-control" />

        <span asp-validation-for="categoryname"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="description" class="form-label"></label>

        <textarea asp-for="description"
                  class="form-control"></textarea>

        <span asp-validation-for="description"
              class="text-danger"></span>
    </div>

    <a asp-action="Categories" class="btn btn-secondary">
        Back
    </a>

    <button type="submit" class="btn btn-primary">
        Create
    </button>

    

</form>