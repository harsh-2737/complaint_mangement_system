<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Complaint Management System</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/complaint_mangement_system.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">

                <a class="navbar-brand fw-bold text-primary"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Complaint Management System
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                <i class="bi bi-shield-lock me-1"></i>
                                Privacy
                            </a>
                        </li>

                    </ul>

                    <div class="d-flex gap-2">

                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-primary btn-sm px-3">

                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Login

                        </a>

                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-primary btn-sm px-3">

                            <i class="bi bi-person-plus me-1"></i>
                            Register

                        </a>

                    </div>

                </div>

            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="border-top bg-light text-muted mt-5 py-3">

        <div class="container text-center">

            <div class="mb-2">

                <i class="bi bi-shield-check text-primary fs-5 me-1"></i>

                <span class="fw-semibold">
                    Complaint Management System
                </span>

            </div>

            <div class="small">
                &copy; 2026 Complaint Management System -
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Privacy"
                   class="text-decoration-none">
                    Privacy
                </a>
            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>