@{
}

@model List<complaint_mangement_system.ViewModels.StaffMemberViewModel>

@{
    ViewData["Title"] = "Staff Members";
    Layout = "~/Views/Staff/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Staff Members</h2>
        <p class="text-muted mb-0">
            Staff members assigned to your category
        </p>
    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        <h4 class="fw-bold mb-3">
            Staff Members
        </h4>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info text-center mb-0">
                No staff members found for this category.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Staff ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Country Code</th>
                            <th>Phone Number</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var staff in Model)
                        {
                            <tr>

                                <td>
                                    @staff.userid
                                </td>

                                <td>
                                    @staff.name
                                </td>

                                <td>
                                    @staff.email
                                </td>

                                <td>
                                    @staff.country_code
                                </td>

                                <td>
                                    @staff.phone_no
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>