@model complaint_mangement_system.ViewModels.StaffComplaintViewModel

@{
    ViewData["Title"] = "Update Complaint";
    Layout = "~/Views/Staff/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Update Complaint</h2>
        <p class="text-muted mb-0">
            Update complaint status
        </p>
    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">
                Complaint ID
            </label>

            <input type="text"
                   class="form-control"
                   value="@Model.complaintid"
                   readonly />

        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">
                User Name
            </label>

            <input type="text"
                   class="form-control"
                   value="@Model.username"
                   readonly />

        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">
                Complaint Title
            </label>

            <input type="text"
                   class="form-control"
                   value="@Model.complaintname"
                   readonly />

        </div>

        <div class="mb-3">

            <label class="form-label fw-bold">
                Description
            </label>

            <textarea class="form-control"
                      rows="4"
                      readonly>@Model.description</textarea>

        </div>

        <form asp-controller="Staff"
              asp-action="Update"
              method="post">

            <input type="hidden"
                   asp-for="complaintid" />

            <div class="mb-3">

                <label asp-for="status"
                       class="form-label fw-bold">
                    Status
                </label>

                <select asp-for="status"
                        class="form-select">

                    <option value="">Select Status</option>
                    <option value="Pending">Pending</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Resolved">Resolved</option>

                </select>

                <span asp-validation-for="status"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Update Status
            </button>

            <a asp-controller="Staff"
               asp-action="Dashboard"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}