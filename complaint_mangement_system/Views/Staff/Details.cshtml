@{
}

@model complaint_mangement_system.ViewModels.StaffComplaintViewModel

@{
    ViewData["Title"] = "Complaint Details";
    Layout = "~/Views/Staff/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Complaint Details</h2>
        <p class="text-muted mb-0">
            View complaint information
        </p>
    </div>

    <div>
        <a asp-controller="Staff"
           asp-action="Complaints"
           class="btn btn-secondary">
            Back
        </a>

        <a asp-controller="Staff"
           asp-action="Update"
           asp-route-id="@Model.complaintid"
           class="btn btn-warning">
            Update Status
        </a>
    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        <div class="row g-4">

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    Complaint ID
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.complaintid"
                       readonly />

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    User ID
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.userid"
                       readonly />

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    User Name
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.username"
                       readonly />

            </div>

            <div class="col-md-6">

                <label class="form-label fw-bold">
                    Category
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.categoryname"
                       readonly />

            </div>

            <div class="col-md-12">

                <label class="form-label fw-bold">
                    Complaint Title
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.complaintname"
                       readonly />

            </div>

            <div class="col-md-12">

                <label class="form-label fw-bold">
                    Description
                </label>

                <textarea class="form-control"
                          rows="5"
                          readonly>@Model.description</textarea>

            </div>

            <div class="col-md-4">

                <label class="form-label fw-bold">
                    Priority
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.priority"
                       readonly />

            </div>

            <div class="col-md-4">

                <label class="form-label fw-bold">
                    Status
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.status"
                       readonly />

            </div>

            <div class="col-md-4">

                <label class="form-label fw-bold">
                    Category ID
                </label>

                <input type="text"
                       class="form-control"
                       value="@Model.categoryid"
                       readonly />

            </div>

        </div>

    </div>

</div>