@{
}

@model List<complaint_mangement_system.ViewModels.StaffComplaintViewModel>

@{
    ViewData["Title"] = "Complaints";
    Layout = "~/Views/Staff/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Complaints</h2>
        <p class="text-muted mb-0">
            Complaints assigned to your category
        </p>
    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body">

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info">
                No complaints found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Complaint ID</th>
                            <th>User Name</th>
                            <th>Category</th>
                            <th>Complaint Title</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var complaint in Model)
                        {
                            <tr>

                                <td>
                                    @complaint.complaintid
                                </td>

                                <td>
                                    @complaint.username
                                </td>

                                <td>
                                    @complaint.categoryname
                                </td>

                                <td>
                                    @complaint.complaintname
                                </td>

                                <td>

                                    @if (complaint.status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (complaint.status == "Resolved")
                                    {
                                        <span class="badge bg-success">
                                            Resolved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @complaint.status
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-controller="Staff"
                                       asp-action="Details"
                                       asp-route-id="@complaint.complaintid"
                                       class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                    <a asp-controller="Staff"
                                       asp-action="Update"
                                       asp-route-id="@complaint.complaintid"
                                       class="btn btn-warning btn-sm">
                                        Update
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>