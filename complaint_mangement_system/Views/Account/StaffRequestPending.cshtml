@{
}

@{
    ViewData["Title"] = "Approval Pending";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-body text-center p-5">

            <i class="bi bi-clock-history fs-1 text-warning"></i>

            <h2 class="mt-3">
                Admin Approval Pending
            </h2>

            <p class="text-muted mt-3">
                Your staff registration request has been submitted successfully.
            </p>

            <p class="text-muted">
                Admin has not approved your request yet.
            </p>

            <p class="text-muted">
                You can access the Staff Dashboard after Admin approves your request.
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary mt-3">
                Back to Login
            </a>

        </div>
    </div>
</div>