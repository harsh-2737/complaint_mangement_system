@{
    ViewData["Title"] = "Staff Request Sent";
}

<div class="container mt-5">

    <div class="card shadow-sm">

        <div class="card-body text-center p-5">

            <i class="bi bi-clock-history fs-1 text-warning"></i>

            <h2 class="mt-3">
                Registration Request Sent
            </h2>

            <p class="text-muted mt-3">
                Your staff registration request has been sent to the Admin.
            </p>

            <p class="text-muted">
                You can login to the Staff Dashboard only after the Admin approves your request.
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary mt-3">
                Go to Login
            </a>

        </div>

    </div>

</div>
